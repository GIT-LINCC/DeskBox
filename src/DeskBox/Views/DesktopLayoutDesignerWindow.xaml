<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskBox.Views.DesktopLayoutDesignerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏 -->
        <Grid
            x:Name="AppTitleBar"
            Padding="18,0,140,0">
            <StackPanel
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center">
                <FontIcon Glyph="&#xE790;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Text="DeskBox · AI 桌面布局设计师" />
            </StackPanel>
        </Grid>

        <!-- 主体双栏结构 -->
        <Grid
            Grid.Row="1"
            Padding="16,12,16,16"
            ColumnSpacing="16"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="388" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：构图流派 + 提示词定制 + 方案库 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" Padding="0,0,2,0">

                    <!-- 卡片 1：构图流派与 AI 定制 -->
                    <Border
                        Padding="16"
                        CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="12">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE80A;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="空间构图流派" FontWeight="SemiBold" FontSize="13.5" />
                                </StackPanel>
                                <TextBlock
                                    Text="切换即刻预览"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="11.5"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>

                            <ComboBox
                                x:Name="LayoutStyleComboBox"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0"
                                SelectionChanged="LayoutStyleComboBox_SelectionChanged">
                                <ComboBoxItem Tag="SurroundStage" Content="🖼️ 环幕剧院 · 四周环绕与中央留白" />
                                <ComboBoxItem Tag="SplitFactions" Content="⚔️ 左右阵营 · 办公与娱乐分屏" />
                                <ComboBoxItem Tag="BottomDockGallery" Content="🚀 底部工作坞 · 顶置胶囊与底部对齐" />
                                <ComboBoxItem Tag="TabbedWorkspaces" Content="🗂️ 四大工作舱 · 深度多标签合并" />
                                <ComboBoxItem Tag="BentoAdaptiveGrid" Content="🍱 Bento 矩阵 · 全分类自适应网格" />
                                <ComboBoxItem Tag="StudioWings" Content="🦅 极客双翼 · 左翼工具与右翼矩阵" />
                            </ComboBox>

                            <StackPanel Spacing="8" Margin="0,2,0,0">
                                <Grid>
                                    <TextBlock
                                        Text="额外设计提示词"
                                        FontWeight="SemiBold"
                                        FontSize="13"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Text="点击下方标签可快速填入"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>

                                <TextBox
                                    x:Name="CustomPromptTextBox"
                                    PlaceholderText="例如：把开发和 AI 工具放左侧，游戏放右下角，中央留出 60% 壁纸，低频分类折叠为顶部胶囊..."
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    FontSize="12.5"
                                    MinHeight="64"
                                    MaxHeight="100" />

                                <!-- 2x2 均匀等宽网格快捷标签，彻底消除文字截断 -->
                                <Grid ColumnSpacing="8" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        Padding="10,5"
                                        FontSize="12"
                                        Content="🖼️ 中央大留白"
                                        Tag="请将所有组件沿屏幕四周边缘环绕排布，屏幕正中央必须留出55%以上的完整壁纸观赏区。"
                                        Click="QuickPromptChip_Click" />
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        Padding="10,5"
                                        FontSize="12"
                                        Content="⚔️ 左办公 · 右娱乐"
                                        Tag="左侧专门放效率组件与编程开发工具，右侧专门放游戏与影音娱乐，中间留出清晰的视觉分割走廊。"
                                        Click="QuickPromptChip_Click" />
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        Padding="10,5"
                                        FontSize="12"
                                        Content="💊 次要折叠顶栏"
                                        Tag="将文件较少的次要分类折叠为顶部悬浮胶囊（is_collapsed=true），高频分类集中在下半屏展开。"
                                        Click="QuickPromptChip_Click" />
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        Padding="10,5"
                                        FontSize="12"
                                        Content="🚫 不合并标签页"
                                        Tag="所有文件格子保持独立展示，不要合并任何多标签页。"
                                        Click="QuickPromptChip_Click" />
                                </Grid>
                            </StackPanel>

                            <Grid ColumnSpacing="8" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="GenerateAiDesignButton"
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    Padding="12,7"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="GenerateAiDesignButton_Click"
                                    Content="✨ AI 定制布局预览" />
                                <Button
                                    x:Name="FastAlgorithmPreviewButton"
                                    Grid.Column="1"
                                    Padding="12,7"
                                    Click="FastAlgorithmPreviewButton_Click"
                                    ToolTipService.ToolTip="无需等待大模型，直接按所选流派秒级计算排布"
                                    Content="⚡ 快速重算" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- AI 思考流实时状态卡片 -->
                    <Border
                        x:Name="AiThinkingCard"
                        Visibility="Collapsed"
                        Padding="14,10"
                        CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="6">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing x:Name="AiProgressRing" Width="15" Height="15" IsActive="True" />
                                    <TextBlock x:Name="AiPhaseText" Text="AI 正在构思空间布局..." FontWeight="SemiBold" FontSize="12.5" />
                                </StackPanel>
                                <Button
                                    x:Name="CancelAiButton"
                                    HorizontalAlignment="Right"
                                    Padding="8,2"
                                    FontSize="11"
                                    Content="取消"
                                    Click="CancelAiButton_Click" />
                            </Grid>
                            <TextBlock
                                x:Name="AiStreamPreviewText"
                                FontSize="11.5"
                                MaxLines="3"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- 卡片 2：已保存布局方案库 -->
                    <Border
                        Padding="16"
                        CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8F1;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="已保存布局方案库" FontWeight="SemiBold" FontSize="13.5" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="SavedCountBadge"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="11.5"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="暂无保存方案" />
                            </Grid>

                            <TextBox
                                x:Name="SavePresetNameBox"
                                HorizontalAlignment="Stretch"
                                FontSize="12.5"
                                PlaceholderText="方案名称（选填，留空将自动按时间命名）" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="SaveCurrentPreviewButton"
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    Padding="8,6"
                                    FontSize="12"
                                    Click="SaveCurrentPreviewButton_Click"
                                    Content="💾 保存当前预览" />
                                <Button
                                    x:Name="CaptureLiveDesktopButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Padding="8,6"
                                    FontSize="12"
                                    Click="CaptureLiveDesktopButton_Click"
                                    Content="📸 备份当前桌面" />
                            </Grid>

                            <StackPanel
                                x:Name="SavedPresetsStack"
                                Margin="0,2,0,0"
                                Spacing="6" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 右侧：一体化 16:9 缩略图工作台 -->
            <Border
                Grid.Column="1"
                Padding="18,14,18,14"
                CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 顶栏：当前方案概览 + 核心操作按钮 -->
                    <Grid Grid.Row="0" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="PreviewTitleText"
                                    Text="🖼️ 环幕剧院式布局"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                                <Border
                                    Padding="8,2"
                                    CornerRadius="5"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock
                                        x:Name="PreviewBreathingText"
                                        Text="留白率 52%"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                                <Border
                                    Padding="8,2"
                                    CornerRadius="5"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock
                                        x:Name="PreviewStatsText"
                                        Text="8 个容器"
                                        FontSize="11.5"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                x:Name="PreviewPhilosophyText"
                                Text="四周环绕排布，释放中央完整壁纸观赏视野。"
                                FontSize="12"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <Button
                                x:Name="ResetToCurrentDesktopButton"
                                Padding="12,7"
                                FontSize="12.5"
                                Click="ResetToCurrentDesktopButton_Click"
                                Content="🔄 还原当前桌面" />
                            <Button
                                x:Name="ApplyToDesktopButton"
                                Padding="16,7"
                                FontSize="12.5"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="ApplyToDesktopButton_Click"
                                Content="🚀 应用此布局到桌面" />
                        </StackPanel>
                    </Grid>

                    <!-- 中央：纯净 16:9 桌面缩略图交互舞台（无重叠水印） -->
                    <Border
                        x:Name="PreviewStageHost"
                        Grid.Row="1"
                        Padding="8"
                        CornerRadius="10"
                        Background="#0A000000"
                        SizeChanged="PreviewStageHost_SizeChanged">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border
                                x:Name="MonitorFrameBorder"
                                Width="800"
                                Height="450"
                                CornerRadius="10"
                                BorderBrush="#38FFFFFF"
                                BorderThickness="1.5"
                                Background="#FF0B1320">
                                <Grid>
                                    <!-- 柔和桌面壁纸底色 -->
                                    <Border CornerRadius="9">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF0D1526" Offset="0.0" />
                                                <GradientStop Color="#FF162238" Offset="0.5" />
                                                <GradientStop Color="#FF0E1E32" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- 交互式微缩组件画布 -->
                                    <Canvas
                                        x:Name="PreviewCanvas"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" />

                                    <!-- 底部模拟任务栏 -->
                                    <Border
                                        Height="20"
                                        VerticalAlignment="Bottom"
                                        CornerRadius="0,0,9,9"
                                        Background="#CC080C14"
                                        BorderBrush="#1AFFFFFF"
                                        BorderThickness="0,1,0,0"
                                        IsHitTestVisible="False">
                                        <StackPanel
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="6">
                                            <Border Width="8" Height="8" CornerRadius="2" Background="#FF38BDF8" />
                                            <Border Width="8" Height="8" CornerRadius="2" Background="#6694A3B8" />
                                            <Border Width="8" Height="8" CornerRadius="2" Background="#6694A3B8" />
                                            <TextBlock
                                                x:Name="CanvasCenterWatermarkText"
                                                Text="16:9 桌面实时映射"
                                                FontSize="10"
                                                Foreground="#77CBD5E1"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 底栏：单行简洁状态与操作反馈 -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                        <TextBlock
                            x:Name="StatusFooterText"
                            Grid.Column="0"
                            Text="💡 提示：在上方 16:9 预览图中可直接按住任意卡片拖拽微调位置，悬停卡片可查看详细子标签。"
                            FontSize="12"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
